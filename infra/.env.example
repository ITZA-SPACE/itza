# VPS stack settings. Copy to infra/.env (git-ignored).
ITZA_ENVIRONMENT=production
ITZA_LOG_LEVEL=INFO
ITZA_CORS_ORIGINS=https://app.example.com
SCIENCE_API_PORT=8100
# NASA Earthdata Login (server-side only).
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
# Earthdata token (alternative to the username and password above).
EARTHDATA_TOKEN=
# Optional host folder with a copy of the dataset store (`sync.py pull`), mounted read-only at
# /data/store; the API reads SMAP and IMERG from it before calling Earthdata.
# ITZA_DATASET_STORE_HOST_DIR=../pipelines/data_store/data
# Cloudflare Zero Trust > Networks > Tunnels > your tunnel > token. Needed only with --profile tunnel.
CLOUDFLARE_TUNNEL_TOKEN=
