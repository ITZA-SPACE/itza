{
  "name": "@itza/web",
  "private": true,
  "type": "module",
  "description": "ITZA web app: map workspace, season replay, evidence cards, 3D twin and generative UI assistant.",
  "scripts": {
    "dev": "vite --port 5180 --strictPort",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "lint": "biome check .",
    "format": "biome check --write .",
    "format:check": "biome format .",
    "typecheck": "pnpm gen && tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "gen": "node scripts/copyKeys.mjs && tsr generate"
  },
  "dependencies": {
    "@itza/adapters-browser": "workspace:*",
    "@itza/engine": "workspace:*",
    "@itza/ui-kit": "workspace:*",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@turf/area": "7.4.0",
    "@turf/center-of-mass": "7.4.0",
    "@turf/length": "7.4.0",
    "idb-keyval": "6.3.0",
    "maplibre-gl": "6.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "terra-draw": "1.39.0",
    "terra-draw-maplibre-gl-adapter": "1.5.0",
    "workbox-window": "7.4.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/router-cli": "1.168.0",
    "@tanstack/router-plugin": "1.169.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "tailwindcss": "4.3.5",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "workbox-build": "7.4.1"
  }
}
