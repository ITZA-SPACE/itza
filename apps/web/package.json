{
  "name": "@itza/web",
  "private": true,
  "type": "module",
  "description": "ITZA web app: map workspace, season replay, evidence cards, 3D twin and generative UI assistant.",
  "scripts": {
    "dev": "vite --port 5180 --strictPort",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "lint": "biome check .",
    "format": "biome check --write .",
    "format:check": "biome format .",
    "typecheck": "pnpm gen && tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "gen": "node scripts/copyKeys.mjs && tsr generate",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.183",
    "@deck.gl/core": "9.4.1",
    "@deck.gl/layers": "9.4.1",
    "@deck.gl/mapbox": "9.4.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/familjen-grotesk": "5.3.0",
    "@itza/adapters-browser": "workspace:*",
    "@itza/engine": "workspace:*",
    "@itza/knowledge": "workspace:*",
    "@itza/ui-kit": "workspace:*",
    "@tanstack/react-query": "5.108.2",
    "@tanstack/react-router": "1.170.46",
    "@turf/area": "7.4.0",
    "@turf/center-of-mass": "7.4.0",
    "@turf/length": "7.4.0",
    "ai": "7.0.179",
    "echarts": "6.1.0",
    "idb-keyval": "6.3.0",
    "katex": "0.19.1",
    "lottie-web": "5.13.0",
    "lucide-react": "1.77.0",
    "maplibre-gl": "6.19.0",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "terra-draw": "1.40.0",
    "terra-draw-maplibre-gl-adapter": "1.5.0",
    "three": "0.187.0",
    "workbox-window": "7.4.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/router-cli": "1.168.0",
    "@tanstack/router-plugin": "1.169.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "tailwindcss": "4.3.5",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.1",
    "workbox-build": "7.4.1",
    "yaml": "2.9.1"
  }
