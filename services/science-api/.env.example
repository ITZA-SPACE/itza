# Data & Science service settings (prefix ITZA_). Copy to .env for local development.
ITZA_ENVIRONMENT=development
ITZA_LOG_LEVEL=INFO
# Comma-separated list of browser origins allowed by CORS.
ITZA_CORS_ORIGINS=http://localhost:5180
# Directory for the file cache and precomputed baseline tables.
ITZA_DATA_DIR=data
# Optional read-only copy of the team dataset store (a `pull` folder, or the Cloud Run mount
# /data/store). SMAP and IMERG are read from it before calling Earthdata.
# ITZA_DATASET_STORE_DIR=../../pipelines/data_store/data
# Upstream NASA POWER requests: timeout, retry count and exponential backoff seed.
ITZA_UPSTREAM_TIMEOUT_S=30
ITZA_UPSTREAM_RETRIES=3
ITZA_UPSTREAM_BACKOFF_S=0.5
# NASA Earthdata Login (https://urs.earthdata.nasa.gov). Server-side only; never ship to the client.
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
# Alternative to username/password: an Earthdata user token. GES DISC access must be authorized.
EARTHDATA_TOKEN=
# Wait at most this long for context work before returning 202; processing continues for polling.
ITZA_CONTEXT_WAIT_S=20

# Versioned LightGBM artifact directory (metadata.json + model.txt)
ITZA_ML_MODEL_DIR=models/stress-v1

# Validated precomputed Prithvi manifests and class GeoTIFFs (no torch runtime)
ITZA_PRITHVI_DIR=models/prithvi
