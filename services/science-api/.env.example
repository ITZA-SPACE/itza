# Data & Science service settings (prefix ITZA_). Copy to .env for local development.
ITZA_ENVIRONMENT=development
ITZA_LOG_LEVEL=INFO
# Comma-separated list of browser origins allowed by CORS.
ITZA_CORS_ORIGINS=http://localhost:5180
# NASA Earthdata Login (https://urs.earthdata.nasa.gov). Server-side only; never ship to the client.
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
