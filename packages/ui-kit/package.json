{
  "name": "@itza/ui-kit",
  "private": true,
  "type": "module",
  "description": "Shared accessible React components and the A2UI answer catalog (schemas, examples, fallback layouts).",
  "exports": {
    ".": "./src/index.ts",
    "./catalog": "./catalog/index.ts",
    "./catalog/react": "./catalog/react/index.ts"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "format:check": "biome format .",
    "typecheck": "tsc -p tsconfig.json",
    "clean": "rm -rf dist coverage",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@a2ui/react": "0.15.0",
    "@a2ui/web_core": "0.15.0",
    "@cfworker/json-schema": "4.1.6",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vitest": "5.1.0"
  }
}
