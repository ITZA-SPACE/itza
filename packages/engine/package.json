{
  "name": "@itza/engine",
  "private": true,
  "type": "module",
  "description": "Pure TypeScript simulation engine: ET0, water balance, thermal, pests, scoring, resilience, Monte Carlo, scenarios, candidates and evidence. No DOM dependencies; runs in a Web Worker and in Node.",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*/index.ts"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "format:check": "biome format .",
    "typecheck": "tsc -p tsconfig.json",
    "clean": "rm -rf dist coverage",
    "schemas:generate": "node scripts/generate-contracts.mjs",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "json-schema-to-typescript": "16.0.0"
  }
}
