{
  "name": "@itza/engine",
  "private": true,
  "type": "module",
  "description": "Pure TypeScript simulation engine: ET0, water balance, thermal, pests, scoring, resilience, Monte Carlo, scenarios, candidates and evidence. No DOM dependencies; runs in a Web Worker and in Node.",
  "exports": {
    ".": "./src/index.ts",
    "./worker/entry": "./src/worker/entry.ts",
    "./*": "./src/*/index.ts"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "format:check": "biome format .",
    "typecheck": "tsc -p tsconfig.json",
    "clean": "rm -rf dist coverage",
    "test": "vitest run --coverage",
    "bench": "vitest run --config vitest.bench.config.ts"
  },
  "dependencies": {
    "@itza/knowledge": "workspace:*",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.1.0",
    "fast-check": "4.10.2",
    "vitest": "5.1.0"
  }
}
