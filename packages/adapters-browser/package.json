{
  "name": "@itza/adapters-browser",
  "private": true,
  "type": "module",
  "description": "Browser data adapters for NASA POWER, ORNL MODIS, CMR and SoilGrids that return canonical series with provenance.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "format:check": "biome format .",
    "typecheck": "tsc -p tsconfig.json",
    "clean": "rm -rf dist coverage",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@itza/engine": "workspace:*",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.1.0",
    "vitest": "5.1.0"
  }
}
