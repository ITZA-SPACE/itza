  "title": "ProjectionResponse",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://itza.dev/schemas/projection.schema.json",
  "description": "Response of GET /v1/projection: monthly climate change factors for 2041-2060 vs the 1995-2014 model historical baseline, per SSP scenario and canonical variable."
}
