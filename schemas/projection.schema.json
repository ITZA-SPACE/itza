          "type": "string"
        },
        "resolution_deg": {
          "title": "Resolution Deg",
          "type": "number"
        },
        "baseline_period": {
          "title": "Baseline Period",
          "type": "string"
        },
        "future_period": {
          "title": "Future Period",
          "type": "string"
        },
        "baseline_table_version": {
          "title": "Baseline Table Version",
          "type": "string"
        },
        "models": {
          "items": {
            "type": "string"
          },
          "title": "Models",
          "type": "array"
        }
      },
      "required": [
        "source",
        "source_version",
        "path",
        "resolution_deg",
        "baseline_period",
        "future_period",
        "baseline_table_version",
        "models"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "VariableFactors": {
      "properties": {
        "kind": {
          "enum": [
            "additive",
            "multiplicative"
          ],
          "title": "Kind",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "models": {
          "title": "Models",
          "type": "integer"
        },
        "median": {
          "items": {
            "type": "number"
          },
          "title": "Median",
          "type": "array"
        },
        "min": {
          "items": {
            "type": "number"
          },
          "title": "Min",
          "type": "array"
        },
        "max": {
          "items": {
            "type": "number"
          },
          "title": "Max",
          "type": "array"
        }
