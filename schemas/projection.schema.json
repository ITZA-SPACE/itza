        "reason",
        "severity"
      ],
      "title": "Gap",
      "type": "object"
    },
    "Provenance": {
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "source_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Version"
        },
        "path": {
          "enum": [
            "power",
            "archive"
          ],
