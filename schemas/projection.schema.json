      "required": [
        "kind",
        "unit",
        "models",
        "median",
        "min",
        "max"
      ],
      "title": "VariableFactors",
      "type": "object"
    }
  },
  "properties": {
    "lat": {
      "title": "Lat",
      "type": "number"
    },
    "lon": {
      "title": "Lon",
      "type": "number"
    },
    "cell_lat": {
      "title": "Cell Lat",
      "type": "number"
    },
    "cell_lon": {
      "title": "Cell Lon",
      "type": "number"
    },
    "months": {
      "const": "index 0 = January",
      "default": "index 0 = January",
      "title": "Months",
      "type": "string"
    },
    "scenarios": {
      "additionalProperties": {
        "additionalProperties": {
          "$ref": "#/$defs/VariableFactors"
